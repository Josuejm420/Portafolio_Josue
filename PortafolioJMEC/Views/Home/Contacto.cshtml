@{
    ViewData["Title"] = "Contacto";
}

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="fw-bold display-5">Ponte en Contacto</h1>
        <p class="text-muted">¿Tienes alguna consulta o propuesta de proyecto? Envíame un mensaje.</p>
    </div>

    <div class="row g-5">
        <!-- Columna de Información de Contacto -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm p-4 bg-light rounded-3 h-100">
                <h3 class="fw-bold text-primary mb-4">Información Profesional</h3>
                
                <div class="d-flex align-items-start mb-4">
                    <div class="fs-3 text-primary me-3">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Nombre</h6>
                        <p class="text-secondary mb-0">Josué Missael Estrada Cárdenas</p>
                    </div>
                </div>

                <div class="d-flex align-items-start mb-4">
                    <div class="fs-3 text-primary me-3">
                        <i class="bi bi-journal-code"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Profesión / Carrera</h6>
                        <p class="text-secondary mb-0">Estudiante de Ingeniería en Sistemas de Información</p>
                    </div>
                </div>

                <div class="d-flex align-items-start mb-4">
                    <div class="fs-3 text-primary me-3">
                        <i class="bi bi-envelope-at-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Correo Electrónico</h6>
                        <p class="text-secondary mb-0">josue1939r@gmail.com</p>
                    </div>
                </div>

                <div class="d-flex align-items-start mb-4">
                    <div class="fs-3 text-primary me-3">
                        <i class="bi bi-github"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Perfil de GitHub</h6>
                        <a href="https://github.com/" target="_blank" class="text-decoration-none">github.com/tuusuario</a>
                    </div>
                </div>

                <div class="d-flex align-items-start">
                    <div class="fs-3 text-primary me-3">
                        <i class="bi bi-linkedin"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">LinkedIn</h6>
                        <a href="https://linkedin.com/" target="_blank" class="text-decoration-none">linkedin.com/in/tuusuario</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna del Formulario de Mensaje -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm p-4 rounded-3">
                <h3 class="fw-bold mb-4">Envíame un Mensaje</h3>
                <form>
                    <div class="mb-3">
                        <label for="nombre" class="form-label fw-semibold">Nombre Completo</label>
                        <input type="text" class="form-control" id="nombre" placeholder="Ingresa tu nombre" required>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold">Correo Electrónico</label>
                        <input type="email" class="form-control" id="email" placeholder="ejemplo@correo.com" required>
                    </div>

                    <div class="mb-3">
                        <label for="asunto" class="form-label fw-semibold">Asunto</label>
                        <input type="text" class="form-control" id="asunto" placeholder="Motivo del contacto">
                    </div>

                    <div class="mb-4">
                        <label for="mensaje" class="form-label fw-semibold">Mensaje</label>
                        <textarea class="form-control" id="mensaje" rows="5" placeholder="Escribe tu mensaje aquí..." required></textarea>
                    </div>

                    <button type="button" class="btn btn-primary btn-lg w-100 fw-semibold">
                        <i class="bi bi-send-fill me-2"></i>Enviar Mensaje
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>